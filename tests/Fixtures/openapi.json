{
    "openapi": "3.1.0",
    "info": {
        "title": "Bookshop API",
        "version": "2.4.1",
        "description": "A catalogue and order API."
    },
    "servers": [
        {
            "url": "https://api.bookshop.test/api/{version}",
            "variables": {
                "version": {
                    "default": "v2"
                }
            }
        }
    ],
    "security": [
        {
            "sanctum": []
        }
    ],
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer",
                "description": "Personal access token issued by the panel."
            }
        },
        "schemas": {
            "AuthorResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "title": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "title"
                ]
            },
            "BookResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "code": {
                        "type": "string",
                        "description": "Always stored in upper case."
                    },
                    "discount_type": {
                        "type": "string",
                        "enum": [
                            "percentage",
                            "fixed"
                        ]
                    },
                    "discount_value": {
                        "type": "number",
                        "description": "Percent or amount in EUR, depending on discount_type."
                    },
                    "discount": {
                        "type": "number",
                        "deprecated": true,
                        "description": "Alias of `discount_value`."
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "valid_until": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "restrictions": {
                        "type": "object",
                        "properties": {
                            "min_order_value": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "max_uses": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "used_count": {
                                "type": "integer"
                            },
                            "first_order_only": {
                                "type": "boolean"
                            }
                        }
                    },
                    "author": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/AuthorResource"
                            }
                        ],
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "code",
                    "discount_type",
                    "discount_value",
                    "is_active",
                    "created_at"
                ]
            },
            "BookListResource": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BookResource"
                        }
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "total": {
                                "type": "integer"
                            },
                            "per_page": {
                                "type": "integer"
                            },
                            "next_cursor": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    }
                }
            },
            "ValidationError": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object"
                    }
                }
            },
            "EditionResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "required": [
                    "id",
                    "first_name",
                    "last_name"
                ]
            }
        }
    },
    "paths": {
        "/books": {
            "get": {
                "tags": [
                    "Books"
                ],
                "summary": "Lists books with cursor pagination.",
                "description": "Without a filter only active books are returned.",
                "x-handler": "BookController@index",
                "x-rate-limit": "60/min",
                "x-since": "v2.0",
                "parameters": [
                    {
                        "name": "If-None-Match",
                        "in": "header",
                        "schema": {
                            "type": "string"
                        },
                        "description": "ETag of the previous response. A hit answers 304."
                    },
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "de",
                                "en"
                            ],
                            "default": "de"
                        },
                        "description": "Language of the error messages."
                    },
                    {
                        "name": "filter[code]",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Substring, case insensitive."
                    },
                    {
                        "name": "filter[is_active]",
                        "in": "query",
                        "schema": {
                            "type": "boolean",
                            "default": true
                        },
                        "description": "Restrict to active books."
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "code",
                                "-code",
                                "created_at",
                                "-created_at"
                            ],
                            "default": "-created_at"
                        },
                        "description": "Sort key."
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 25
                        },
                        "description": "Between 1 and 100."
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Taken from meta.next_cursor."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "One page of books.",
                        "headers": {
                            "ETag": {
                                "schema": {
                                    "type": "string"
                                },
                                "example": "\"a3f1\""
                            },
                            "Cache-Control": {
                                "schema": {
                                    "type": "string"
                                },
                                "example": "private, max-age=60"
                            },
                            "X-RateLimit-Remaining": {
                                "schema": {
                                    "type": "integer"
                                },
                                "example": 58
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookListResource"
                                },
                                "example": {
                                    "data": [
                                        {
                                            "id": "9b4e2c1f-0000-4000-8000-000000000000",
                                            "code": "LEGUIN-01",
                                            "discount_type": "percentage",
                                            "discount_value": 10,
                                            "is_active": true,
                                            "valid_until": null,
                                            "created_at": "2026-06-01T00:00:00+00:00"
                                        }
                                    ],
                                    "meta": {
                                        "total": 42,
                                        "per_page": 25,
                                        "next_cursor": "eyJ2"
                                    }
                                }
                            }
                        }
                    },
                    "304": {
                        "description": "Not modified. No body is sent when If-None-Match matches."
                    },
                    "401": {
                        "description": "Not authenticated.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid filter or sort key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                },
                                "example": {
                                    "message": "Invalid sort key.",
                                    "errors": {
                                        "sort": [
                                            "Not allowed."
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Books"
                ],
                "summary": "Creates a book.",
                "requestBody": {
                    "required": true,
                    "description": "The book to create.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "code",
                                    "value"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "description": "The code customers redeem.",
                                        "maxLength": 32
                                    },
                                    "value": {
                                        "type": "integer",
                                        "description": "The discount in cents."
                                    },
                                    "expires_at": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true,
                                        "description": "When the book stops working."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created book.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResource"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/books/{code}": {
            "parameters": [
                {
                    "name": "code",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "string"
                    },
                    "description": "The book code.",
                    "example": "LEGUIN-01"
                }
            ],
            "get": {
                "tags": [
                    "Books"
                ],
                "summary": "Shows a single book.",
                "deprecated": true,
                "responses": {
                    "200": {
                        "description": "The book.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResource"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/editions": {
            "get": {
                "tags": [
                    "Editions"
                ],
                "responses": {}
            }
        },
        "/authors": {
            "get": {
                "tags": [
                    "Authors"
                ],
                "summary": "Lists authors.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Authors.",
                        "content": {
                            "application/json": {}
                        }
                    }
                }
            }
        },
        "/editions/{edition}": {
            "parameters": [
                {
                    "name": "edition",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "description": "The edition UUID."
                }
            ],
            "patch": {
                "tags": [
                    "Editions"
                ],
                "summary": "Updates a edition.",
                "responses": {
                    "200": {
                        "description": "The updated edition.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EditionResource"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Editions"
                ],
                "summary": "Removes a edition from an event.",
                "responses": {
                    "204": {
                        "description": "Removed. No body is returned."
                    }
                }
            }
        }
    }
}
