                    "email": "mara@example.test",
                    "addresses": [
                      {
                        "line1": "Kastanienallee 12",
                        "line2": null,
                        "postcode": "10435",
                        "city": "Berlin",
                        "country": "DE"
                      }
                    ]
                  },
                  "lines": [
                    {
                      "isbn": "978-0-441-01359-3",
                      "quantity": 2,
                      "unit_price": {
                        "amount": 1099,
                        "currency": "EUR"
                      }
                    }
                  ],
                  "total": {
                    "amount": 2198,
