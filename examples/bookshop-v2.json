{
  "openapi": "3.1.0",
  "info": {
    "title": "Bookshop API",
    "version": "2.4.0",
    "description": "A fictional catalogue and order API, written to show what the explorer does with a document. Nothing here is a real service."
  },
  "servers": [
    {
      "url": "https://api.bookshop.test",
      "description": "Production"
    },
    {
      "url": "https://staging.bookshop.test",
      "description": "Staging"
    }
  ],
  "tags": [
    {
      "name": "Books",
      "description": "The catalogue."
    },
    {
      "name": "Orders",
      "description": "What customers bought."
    },
    {
      "name": "Customers",
      "description": "Who bought it."
    },
    {
      "name": "Exports",
      "description": "Bulk formats for other systems."
    },
    {
      "name": "System",
      "description": "Operational endpoints."
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v2/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Lists books.",
        "description": "Cursor-paginated, filtered by `q` and `status`, and sorted by `sort`. The catalogue is public data, so this is the endpoint to try first.",
        "x-handler": "BookController@index",
        "x-rate-limit": "120/min",
        "x-since": "v2.0",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Matches title, subtitle and author name.",
            "schema": {
              "type": "string"
            },
            "example": "earthsea"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Narrows the list to one shelf state.",
            "schema": {
              "type": "string",
              "enum": [
                "available",
                "reprinting",
                "out-of-print"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort key, prefixed with `-` for descending order.",
            "schema": {
              "type": "string",
              "enum": [
                "title",
                "-title",
                "created_at",
                "-created_at"
              ],
              "default": "-created_at"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Records per page, at most 100.",
            "schema": {
              "type": "integer",
              "default": 25,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The `meta.next_cursor` of the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of books.",
            "headers": {
              "X-RateLimit-Remaining": {
                "description": "Requests left in the current window.",
                "schema": {
                  "type": "integer"
                },
                "example": 118
              },
              "Cache-Control": {
                "description": "The catalogue is cacheable for a minute.",
                "schema": {
                  "type": "string"
                },
                "example": "public, max-age=60"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookCollection"
                },
                "example": {
                  "data": [
                    {
                      "isbn": "978-0-441-01359-3",
                      "title": "The Left Hand of Darkness",
                      "subtitle": null,
                      "status": "available",
                      "author": {
                        "name": "Ursula K. Le Guin",
                        "born": 1929
                      },
                      "editions": [
                        {
                          "isbn": "978-0-441-01359-3",
                          "format": "paperback",
                          "published_at": "2019-09-03",
                          "price": {
                            "amount": 1099,
                            "currency": "EUR"
                          },
                          "in_stock": 7
                        },
                        {
                          "isbn": "978-0-14-303669-8",
                          "format": "hardcover",
                          "published_at": "2017-04-25",
                          "price": {
                            "amount": 2499,
                            "currency": "EUR"
                          },
                          "in_stock": 0
                        }
                      ],
                      "tags": [
                        "science-fiction",
                        "classics"
                      ],
                      "created_at": "2024-11-02T09:14:31+00:00"
                    },
                    {
                      "isbn": "978-0-241-95367-9",
                      "title": "A Wizard of Earthsea",
                      "subtitle": "The Earthsea Cycle, Book One",
                      "status": "reprinting",
                      "author": {
                        "name": "Ursula K. Le Guin",
                        "born": 1929
                      },
                      "editions": [
                        {
                          "isbn": "978-0-241-95367-9",
                          "format": "ebook",
                          "published_at": "2018-02-01",
                          "price": {
                            "amount": 899,
                            "currency": "EUR"
                          },
                          "in_stock": 0
                        }
                      ],
                      "tags": [
                        "fantasy"
                      ],
                      "created_at": "2025-03-18T11:47:02+00:00"
                    }
                  ],
                  "meta": {
                    "next_cursor": "eyJpZCI6MTQyfQ",
                    "per_page": 25
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/BookCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Adds a book to the catalogue.",
        "description": "The author is created along with the book where the name is new.",
        "x-handler": "BookController@store",
        "requestBody": {
          "required": true,
          "description": "The book to add.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookInput"
              },
              "example": {
                "isbn": "978-0-241-95367-9",
                "title": "A Wizard of Earthsea",
                "status": "available",
                "author": {
                  "name": "Ursula K. Le Guin",
                  "born": 1929
                },
                "tags": [
                  "fantasy"
                ]
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/BookInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The book as it was stored.",
            "headers": {
              "Location": {
                "description": "Where the new book can be read.",
                "schema": {
                  "type": "string"
                },
                "example": "/v2/books/978-0-241-95367-9"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                },
                "example": {
                  "isbn": "978-0-241-95367-9",
                  "title": "A Wizard of Earthsea",
                  "subtitle": "The Earthsea Cycle, Book One",
                  "status": "reprinting",
                  "author": {
                    "name": "Ursula K. Le Guin",
                    "born": 1929
                  },
                  "editions": [
                    {
                      "isbn": "978-0-241-95367-9",
                      "format": "ebook",
                      "published_at": "2018-02-01",
                      "price": {
                        "amount": 899,
                        "currency": "EUR"
                      },
                      "in_stock": 0
                    }
                  ],
                  "tags": [
                    "fantasy"
                  ],
                  "created_at": "2025-03-18T11:47:02+00:00"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/v2/books/{isbn}": {
      "parameters": [
        {
          "name": "isbn",
          "in": "path",
          "required": true,
          "description": "ISBN-13 of the book, with or without hyphens.",
          "schema": {
            "type": "string"
          },
          "example": "978-0-441-01359-3"
        }
      ],
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Reads one book.",
        "description": "Every edition of the title comes with it.",
        "x-handler": "BookController@show",
        "x-since": "v2.0",
        "responses": {
          "200": {
            "description": "The book.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                },
                "example": {
                  "isbn": "978-0-441-01359-3",
                  "title": "The Left Hand of Darkness",
                  "subtitle": null,
                  "status": "available",
                  "author": {
                    "name": "Ursula K. Le Guin",
                    "born": 1929
                  },
                  "editions": [
                    {
                      "isbn": "978-0-441-01359-3",
                      "format": "paperback",
                      "published_at": "2019-09-03",
                      "price": {
                        "amount": 1099,
                        "currency": "EUR"
                      },
                      "in_stock": 7
                    },
                    {
                      "isbn": "978-0-14-303669-8",
                      "format": "hardcover",
                      "published_at": "2017-04-25",
                      "price": {
                        "amount": 2499,
                        "currency": "EUR"
                      },
                      "in_stock": 0
                    }
                  ],
                  "tags": [
                    "science-fiction",
                    "classics"
                  ],
                  "created_at": "2024-11-02T09:14:31+00:00"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Books"
        ],
        "summary": "Updates a book.",
        "description": "Superseded by `PUT /v1/books/{isbn}`, which replaces the whole record.",
        "deprecated": true,
        "x-since": "v2.2",
        "requestBody": {
          "required": true,
          "description": "The fields to change.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "A corrected title."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "available",
                      "reprinting",
                      "out-of-print"
                    ],
                    "description": "A new shelf state."
                  }
                }
              },
              "example": {
                "status": "out-of-print"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The book as it now stands.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                },
                "example": {
                  "isbn": "978-0-441-01359-3",
                  "title": "The Left Hand of Darkness",
                  "subtitle": null,
                  "status": "available",
                  "author": {
                    "name": "Ursula K. Le Guin",
                    "born": 1929
                  },
                  "editions": [
                    {
                      "isbn": "978-0-441-01359-3",
                      "format": "paperback",
                      "published_at": "2019-09-03",
                      "price": {
                        "amount": 1099,
                        "currency": "EUR"
                      },
                      "in_stock": 7
                    },
                    {
                      "isbn": "978-0-14-303669-8",
                      "format": "hardcover",
                      "published_at": "2017-04-25",
                      "price": {
                        "amount": 2499,
                        "currency": "EUR"
                      },
                      "in_stock": 0
                    }
                  ],
                  "tags": [
                    "science-fiction",
                    "classics"
                  ],
                  "created_at": "2024-11-02T09:14:31+00:00"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Removes a book from the catalogue.",
        "description": "The orders that reference it keep their own snapshot of the title.",
        "responses": {
          "204": {
            "description": "Removed, nothing to return."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v2/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Lists orders.",
        "description": "Newest first, filtered by status and date.",
        "x-handler": "OrderController@index",
        "x-rate-limit": "60/min",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Narrows the list to one state.",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "paid",
                "shipped",
                "cancelled"
              ]
            }
          },
          {
            "name": "placed_after",
            "in": "query",
            "description": "Only orders placed on or after this date.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-08-01"
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Records per page, at most 100.",
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of orders.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCollection"
                },
                "example": {
                  "data": [
                    {
                      "id": "4f1c9a20-7d3e-4b16-9f8a-2c5e7b0d1a63",
                      "number": "ORD-2026-004182",
                      "status": "paid",
                      "customer": {
                        "id": "9b4e2c1f-3a7d-4f82-b5e0-1d6c8a9f2e34",
                        "name": "Mara Feldmann",
                        "email": "mara@example.test",
                        "addresses": [
                          {
                            "line1": "Kastanienallee 12",
                            "line2": null,
                            "postcode": "10435",
                            "city": "Berlin",
                            "country": "DE"
                          }
                        ]
                      },
                      "lines": [
                        {
                          "isbn": "978-0-441-01359-3",
                          "quantity": 2,
                          "unit_price": {
                            "amount": 1099,
                            "currency": "EUR"
                          }
                        }
                      ],
                      "total": {
                        "amount": 2198,
                        "currency": "EUR"
                      },
                      "placed_at": "2026-08-19T14:02:11+00:00"
                    }
                  ],
                  "meta": {
                    "next_cursor": null,
                    "per_page": 25
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Places an order.",
        "description": "Reserves stock for every line and charges the customer’s stored method.",
        "responses": {
          "201": {
            "description": "The order as it was placed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "4f1c9a20-7d3e-4b16-9f8a-2c5e7b0d1a63",
                  "number": "ORD-2026-004182",
                  "status": "paid",
                  "customer": {
                    "id": "9b4e2c1f-3a7d-4f82-b5e0-1d6c8a9f2e34",
                    "name": "Mara Feldmann",
                    "email": "mara@example.test",
                    "addresses": [
                      {
                        "line1": "Kastanienallee 12",
                        "line2": null,
                        "postcode": "10435",
                        "city": "Berlin",
                        "country": "DE"
                      }
                    ]
                  },
                  "lines": [
                    {
                      "isbn": "978-0-441-01359-3",
                      "quantity": 2,
                      "unit_price": {
                        "amount": 1099,
                        "currency": "EUR"
                      }
                    }
                  ],
                  "total": {
                    "amount": 2198,
                    "currency": "EUR"
                  },
                  "placed_at": "2026-08-19T14:02:11+00:00"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/v2/orders/{order}": {
      "parameters": [
        {
          "name": "order",
          "in": "path",
          "required": true,
          "description": "Identifier of the order.",
          "schema": {
