{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "dardangashi/filament-api-explorer",
	"description": "An OpenAPI-driven API explorer for Filament panels: browse endpoints, inspect response schemas, copy request samples and send live GET requests.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"laravel",
		"filament",
		"openapi",
		"swagger",
		"api",
		"documentation",
		"api-explorer"
	],
	"authors": [
		{
			"name": "Dardan Gashi",
			"email": "REDACTED"
		}
	],
	"require": {
		"php": "^8.3",
		"filament/filament": "^5.0",
		"illuminate/contracts": "^12.0 || ^13.0",
		"illuminate/http": "^12.0 || ^13.0",
		"illuminate/support": "^12.0 || ^13.0",
		"spatie/laravel-package-tools": "^1.16",
		"symfony/yaml": "^7.0 || ^8.0"
	},
	"require-dev": {
		"dedoc/scramble": "^0.13",
		"larastan/larastan": "^3.4",
		"laravel/pint": "^1.18",
		"orchestra/testbench": "^11.0",
		"pestphp/pest": "^4.0",
		"pestphp/pest-plugin-laravel": "^4.0",
		"pestphp/pest-plugin-livewire": "^4.0",
		"phpstan/phpstan": "^2.1"
	},
	"suggest": {
		"dedoc/scramble": "Generates the OpenAPI document from the routes themselves (^0.13), which enables the \"scramble\" source driver and the endpoint facts."
	},
	"autoload": {
		"psr-4": {
			"DardanGashi\\FilamentApiExplorer\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"DardanGashi\\FilamentApiExplorer\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"DardanGashi\\FilamentApiExplorer\\ApiExplorerServiceProvider"
			]
		}
	},
	"scripts": {
		"test": "vendor/bin/pest",
		"lint": "vendor/bin/pint",
		"lint:test": "vendor/bin/pint --test",
		"analyse": "vendor/bin/phpstan analyse",
		"check": [
			"@lint:test",
			"@analyse",
			"@test"
		]
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
